# Copy to /home/pi/.config/project006/env on each drone and to your ground PC
# shell (export ...). chmod 600 it. Never commit the real file.
P006_SWARM_KEY=replace-with-output-of-python3--c-import-secrets-print-secrets.token_hex-16
# Same passphrase you enter in Mission Planner's MAVLink Signing screen:
P006_MAVLINK_PASSPHRASE=replace-with-a-long-passphrase
